# Secrets SERVEUR des Edge Functions. À définir avec `supabase secrets set --env-file supabase/functions/.env`
# (jamais dans l'appli mobile). SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont fournis par Supabase.

# Prestataire actif : none | enablebanking | bridge | powens (powens : adaptateur non implémenté)
BANKING_PROVIDER=none

# Enable Banking — Control Panel > API applications (application de type production)
ENABLE_BANKING_APP_ID=
# Contenu complet du fichier de clé privée (BEGIN PRIVATE KEY … END PRIVATE KEY).
# Sur une seule ligne, remplacer les retours à la ligne par 
.
ENABLE_BANKING_PRIVATE_KEY=

# Bridge API v3 — console Bridge (sandbox puis production : identifiants distincts)
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=
# Secret(s) de signature des webhooks, séparés par des virgules pendant une rotation
BRIDGE_WEBHOOK_SECRETS=

# Lien profond de retour vers l'appli après le parcours bancaire
APP_RETURN_URL=vault://bank/callback

# Sites web autorisés comme retour après la banque (origines https exactes, séparées par des virgules)
ALLOWED_RETURN_ORIGINS=

# Secret des synchronisations planifiées (en-tête x-vault-cron), 64 caractères aléatoires
SYNC_CRON_SECRET=
