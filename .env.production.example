# Copier en .env.production.local (non versionné), ou définir dans les variables d'environnement EAS (profil production).
# Projet Supabase DISTINCT de celui de développement.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_SUPABASE_URL=https://<projet-prod>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<clé publishable du projet prod>
