{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@shared/*": ["./supabase/functions/_shared/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "tests",
    "scripts",
    "supabase/functions/*/index.ts",
    "supabase/functions/_shared/server/context.ts",
    "supabase/functions/_shared/server/sync-repository.ts"
  ]
}
